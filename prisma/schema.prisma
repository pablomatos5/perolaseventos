generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  edition     String // ex.: "2K27" — também escolhe o tema de cores
  startsAt    DateTime
  venue       String
  city        String
  description String
  published   Boolean      @default(false)
  /// Pix em 2x: liga a opção no pedido e define o prazo (dias depois da 1ª parcela) para pagar a 2ª.
  /// O prazo nunca passa de 2 dias antes da festa.
  splitPixEnabled Boolean   @default(false)
  splitPixDays    Int       @default(15)
  /// Taxa do cartão repassada ao comprador, em centésimos de % (499 = 4,99%). 0 = cartão sai pelo mesmo preço do Pix.
  /// O acréscimo é calculado para o vendedor receber o valor cheio: total ÷ (1 − taxa).
  cardFeeBps      Int       @default(0)
  createdAt   DateTime     @default(now())
  ticketTypes TicketType[]
  orders      Order[]
  highlights  Highlight[]
  attractions Attraction[]
}

/// Detalhes da festa mostrados na seção "A festa" (open bar, estrutura, local...).
model Highlight {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  icon        String // chave do ícone: bar, river, fireworks, crown, music, food, security...
  title       String
  description String
  sortOrder   Int    @default(0)
}

/// Line-up. `announced = false` aparece como "Em breve" (para anunciar aos poucos, como no Instagram).
model Attraction {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  genre     String  @default("")
  time      String  @default("") // texto livre: "23h", "Virada", "02h"
  announced Boolean @default(true)
  headliner Boolean @default(false)
  instagram String  @default("") // @ sem arroba, ex.: rebelodj_
  imageUrl  String  @default("") // foto oficial do artista (vazio = arte da Pérolas)
  videoUrl  String  @default("") // vídeo curto (mudo) que toca no verso do card
  sortOrder Int     @default(0)
}

/// Setor/tipo de ingresso (Pista, Camarote...). Cada um tem a própria sequência de lotes.
model TicketType {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  description      String   @default("")
  sortOrder        Int      @default(0)
  maxPerOrder      Int      @default(10)
  paused           Boolean  @default(false)
  batches          Batch[]
  tickets          Ticket[]
}

/// Lote. Encerra no que vier primeiro: esgotar `quantity` ou passar de `endsAt`.
/// `closedAt` preenchido = encerrado para sempre (o lote não reabre com sobras de reservas expiradas).
model Batch {
  id             String     @id @default(cuid())
  ticketTypeId   String
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  name           String // "1º lote"
  sortOrder      Int
  priceCents     Int
  femalePriceCents Int? // ingresso feminino; vazio = mesmo preço do masculino (priceCents)
  quantity       Int
  startsAt       DateTime?
  endsAt         DateTime?
  closedAt       DateTime?
  hidden         Boolean    @default(false) // cortesia/lista: não aparece no site
  /// Vendidos fora do site (presencial, antes do site): ocupam vaga e contam na barra "% vendido",
  /// mas não entram na receita do painel (não passaram pelo site).
  soldOffline    Int        @default(0)
  tickets        Ticket[]

  @@unique([ticketTypeId, sortOrder])
}

enum OrderStatus {
  PENDING // reservado, aguardando pagamento
  PARTIAL // Pix em 2x: 1ª parcela paga; ingressos reservados até `expiresAt` (prazo da 2ª), sem entrega
  PAID
  EXPIRED
  CANCELED
  REFUNDED
}

enum PaymentPlan {
  FULL // à vista (Pix ou cartão)
  PIX_2X // Pix em duas parcelas: o ingresso só sai depois da 2ª
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // código curto mostrado ao cliente
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  buyerName     String
  email         String
  phone         String
  cpf           String
  whatsappOptIn Boolean     @default(false)
  status        OrderStatus @default(PENDING)
  totalCents    Int // ingressos + taxa de serviço (o que o cliente paga)
  feeCents      Int         @default(0) // taxa de serviço (dos desenvolvedores), já incluída no total
  expiresAt     DateTime
  paidAt        DateTime?
  paymentRef    String? // id da cobrança no gateway
  paidLate      Boolean     @default(false) // pagamento chegou depois da reserva expirar
  paymentPlan     PaymentPlan @default(FULL)
  firstPaidCents  Int         @default(0) // Pix em 2x: valor da 1ª parcela já paga
  firstPaidAt     DateTime?
  firstPaymentRef String? // id da 1ª parcela no gateway (a 2ª fica em paymentRef)
  createdAt     DateTime    @default(now())
  tickets       Ticket[]
  deliveries    Delivery[]
  pixCharges    PixCharge[]

  @@index([status, expiresAt])
}

/// Pix gerado no próprio site (Checkout Transparente): QR e "copia e cola" guardados para a página do pedido
/// mostrar o mesmo código ao recarregar. kind = pix (à vista) | pix2x-1 | pix2x-2 (parcelas do Pix em 2x).
model PixCharge {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String
  paymentId   String   @unique
  amountCents Int
  qrCode      String // Pix copia e cola
  qrBase64    String // imagem do QR (PNG em base64)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([orderId, kind])
}

enum TicketGender {
  MASCULINO
  FEMININO
}

enum TicketStatus {
  RESERVED
  VALID
  CANCELED
}

model Ticket {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  batchId      String
  batch        Batch        @relation(fields: [batchId], references: [id])
  priceCents   Int // preço travado no momento da reserva
  gender       TicketGender? // masculino/feminino; vazio = cortesia
  holderName   String
  status       TicketStatus @default(RESERVED)
  usedAt       DateTime?
  usedBy       String? // qual aparelho da portaria validou
  checkinMethod String? // "qr", "manual" (busca por nome) ou "offline" (sincronizado depois)
  /// Saída temporária: o porteiro registra a saída, o mesmo QR volta a valer para UMA reentrada (até MAX_EXITS)
  exitCount    Int           @default(0)
  lastExitAt   DateTime?
  // Versão do QR: reemitir/transferir soma 1 e o QR (e o link individual) anterior para de valer.
  qrVersion    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([batchId, status])
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

/// Registro de cada envio do ingresso, para o painel mostrar falhas e permitir reenviar.
model Delivery {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   DeliveryChannel
  ok        Boolean
  detail    String          @default("")
  createdAt DateTime        @default(now())
}

/// Celular/maquininha autorizado a validar ingressos. O aparelho guarda um código secreto;
/// aqui fica só o hash dele. Revogar = o aparelho para de funcionar na hora.
model PortariaDevice {
  id         String    @id @default(cuid())
  name       String // "Portão 1", "Camarote"...
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
}

/// Quem fez o quê: ações do painel, entradas manuais na portaria, trocas de titular e reemissões.
model AuditLog {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  actor  String // "painel", "portaria: Portão 1", "cliente"...
  action String
  detail String   @default("")

  @@index([at])
}

/// Conta Mercado Pago do VENDEDOR (dona do evento), ligada à aplicação dos desenvolvedores pelo botão
/// "Conectar Mercado Pago" do painel (OAuth). As cobranças saem em nome dela e a taxa de serviço vai para os
/// desenvolvedores (marketplace_fee). Tokens guardados cifrados (AES-256-GCM, src/lib/mp-account.ts). Só uma linha.
model MpAccount {
  id           String   @id @default("principal")
  mpUserId     String
  nickname     String   @default("")
  accessToken  String // cifrado
  refreshToken String // cifrado
  publicKey    String   @default("")
  liveMode     Boolean  @default(true)
  expiresAt    DateTime
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
